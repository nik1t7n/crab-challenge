# Upstream checkouts live beside our code, each with its own venv (jumper-design must
# stay a sibling of jumper, never a submodule).
/upstream/
# Rendered clips are regenerated by tools/render_gallery.py.
/renders/**/*.mp4
/renders/**/.*
.venv/
__pycache__/
.DS_Store
/renders/frames/
/report/clips/
# Recorded poses and scene models (about 80 MB each) are regenerated by the poses stage.
/renders/**/*.mjb
/renders/**/*.npz
/.venv-audio/
/audio/*.mp3
/film/node_modules/
/film/out/
/film/public/shots
/film/public/audio
# Blender frames and bakes are regenerated by tools/film/blend_bake.py and tools/film/blender/.
/renders/bedroom_blend/
/film/public/bedroom
/audio/candidates/
